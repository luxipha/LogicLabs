{
  "name": "ly-son-island-mission",
  "version": "1.0.0",
  "private": true,
  "description": "The Lý Sơn Island Mission — a config-driven educational story video built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "dev:playground": "npm run build:playground && node scripts/serve-docs.mjs",
    "build:playground": "node scripts/build-classroom.mjs",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio",
    "render": "remotion render LysSonMission out/LysSonMission.mp4",
    "render:radar": "remotion render RadarMission out/RadarMission.mp4",
    "render:golf": "remotion render GolfMission out/GolfMission.mp4",
    "render:frog": "remotion render FrogMission out/FrogMission.mp4",
    "render:monster-truck": "remotion render MonsterTruckMission out/MonsterTruckMission.mp4",
    "render:garage-door": "remotion render GarageDoorMission out/GarageDoorMission.mp4",
    "render:trex": "remotion render TrexMission out/TrexMission.mp4",
    "render:electric-tractor": "remotion render ElectricTractorMission out/ElectricTractorMission.mp4",
    "render:soccer": "remotion render SoccerMission out/SoccerMission.mp4",
    "render:seesaw": "remotion render SeesawMission out/SeesawMission.mp4",
    "render:banknote-verifier": "remotion render BanknoteVerifierMission out/BanknoteVerifierMission.mp4",
    "render:kangaroo": "remotion render KangarooMission out/KangarooMission.mp4",
    "still": "remotion still",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@remotion/cli": "^4.0.509",
    "@remotion/install-whisper-cpp": "4.0.509",
    "@remotion/three": "^4.0.509",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.509",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
